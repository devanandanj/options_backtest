# ── Secrets ──────────────────────────────────────────────────────
# First, and deliberately broad. Nothing here is currently used by the project —
# it needs no keys, and the NSE archives are public — but a downloader that one
# day wants a session token is exactly how a credential reaches a public repo.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
secrets.*
*.secret

# ── Editor and tooling ───────────────────────────────────────────
.idea/
.vscode/
/.claude
*.swp
*~

# ── Build output ─────────────────────────────────────────────────
cmake-build-*/
build/
bin/
lib/
out/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.ninja
.ninja_*
compile_commands.json
CTestTestfile.cmake
Testing/
# CMake writes this to the repository root and it embeds absolute paths,
# which would publish the local username and directory layout.
cmake_test_discovery_*.json

*.o
*.obj
*.so
*.dylib
*.dll
*.exe
*.a
*.lib
*.pdb
*.ilk
*.exp

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# ── Data ─────────────────────────────────────────────────────────
# Partial downloads. The downloader writes to .tmp and moves it into place, so a
# stray .tmp is an interrupted run rather than anything worth keeping.
*.csv.tmp
data/sample/*.temp.csv

# Scratch. temp/bhavcpy.py is an earlier prototype of download_bhavcopies.py,
# kept locally for reference but superseded and not worth publishing.
temp/

# ── Deployment ───────────────────────────────────────────────────
.vercel
node_modules/

# ── OS ───────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
core
*.dmp
